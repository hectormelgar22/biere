---
// Fachada de BIÉRE a escala de la imagen (1672×941). La puerta es un hueco: detrás se ve el
// interior del bar. Una persiana lo tapa y sube con el scroll; el letrero lleva el logotipo real.
interface Props { imagen: string }
const { imagen } = Astro.props;
const P = { x: 655, y: 500, w: 123, h: 322 };
const hueco = `M${P.x} ${P.y}V${P.y + P.h}H${P.x + P.w}V${P.y}Z`;
---
<svg class="fachada" data-cine-fachada viewBox="0 0 1672 941" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
  <defs>
    <clipPath id="fz-puerta"><path d={hueco} /></clipPath>
    <clipPath id="fz-sin-puerta"><path clip-rule="evenodd" d={`M-5000 -5000H6700V5900H-5000Z${hueco}`} /></clipPath>
    <radialGradient id="fz-halo">
      <stop offset="0.5" stop-color="#ffc56b" stop-opacity="0.5" />
      <stop offset="1" stop-color="#e8952c" stop-opacity="0" />
    </radialGradient>
    <linearGradient id="fz-metal" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#5a4128" />
      <stop offset="0.3" stop-color="#2c2219" />
      <stop offset="1" stop-color="#17120d" />
    </linearGradient>
    <pattern id="fz-lamas" width="123" height="13" patternUnits="userSpaceOnUse" y="500">
      <rect width="123" height="1.6" fill="#000" fill-opacity="0.75" />
      <rect y="1.6" width="123" height="1.2" fill="#ffd9a0" fill-opacity="0.13" />
    </pattern>
  </defs>

  <!-- Noche fuera de la imagen -->
  <path class="fz-noche" fill-rule="evenodd" d={`M-5000 -5000H6700V5900H-5000Z${hueco}`} />
  <image href={imagen} width="1672" height="941" clip-path="url(#fz-sin-puerta)" />

  <!-- Persiana de la puerta -->
  <g clip-path="url(#fz-puerta)">
    <g class="fz-persiana-intro">
      <g class="fz-persiana">
        <rect x={P.x} y={P.y} width={P.w} height={P.h} fill="url(#fz-metal)" />
        <rect x={P.x} y={P.y} width={P.w} height={P.h} fill="url(#fz-lamas)" />
        <rect x={P.x} y={P.y + P.h - 5} width={P.w} height="5" fill="#0c0906" />
        <path class="fz-tirador" d={`M${P.x + 46} ${P.y + P.h - 14}h31`} />
      </g>
    </g>
  </g>

  <!-- Al cargar, la calle está a oscuras y se encienden las luces -->
  <rect class="fz-apagon" x="-5000" y="-5000" width="11700" height="10900" />

  <!-- Letrero con el logotipo real: se enciende como un neón -->
  <g class="fz-letrero">
    <circle class="fz-halo" cx="980" cy="255" r="150" fill="url(#fz-halo)" />
    <circle class="fz-disco" cx="980" cy="255" r="72" />
    <use href="#logo-biere" x="922" y="193" width="116" height="124" class="fz-logo" />
  </g>
</svg>
