---
import Icon from './Icon.astro';
import resenas from '../data/resenas.json';
import { negocio } from '../lib/site';
---
<section class="section opiniones" id="opiniones" aria-labelledby="opiniones-title">
  <div class="wrap">
    <h2 id="opiniones-title" class="opiniones__title" data-reveal>
      <span class="display opiniones__nota">{negocio.valoracion.nota}</span>
      <span class="opiniones__texto">de media en Google, con {negocio.valoracion.resenas.toLowerCase()}. Esto es lo que cuentan algunas:</span>
    </h2>

    <div class="opiniones__lista">
      {resenas.resenas.map((r, i) => (
        <figure class="opinion" data-reveal style={`--i:${i}`}>
          <blockquote><p>«{r.texto}»</p></blockquote>
          <figcaption>{r.autor}, en {r.fuente}</figcaption>
        </figure>
      ))}
    </div>

    <p class="opiniones__mas">
      <a class="text-link" href={negocio.enlaces.googleMaps} target="_blank" rel="noopener">
        Leer todas en Google <Icon name="externo" /><span class="sr-only"> (se abre en otra pestaña)</span>
      </a>
      <span>Datos de {negocio.valoracion.fecha}.</span>
    </p>
  </div>
</section>
