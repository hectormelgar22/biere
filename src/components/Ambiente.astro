---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import { foto, negocio } from '../lib/site';

const galeria = [
  { clase: 'galeria__item--a', foto: 'noche-de-futbol', widths: [360, 540, 720], sizes: '(min-width: 720px) 40vw, 100vw', alt: 'Noche de partido en BIÉRE: el local lleno mirando el fútbol en la pantalla.', pie: 'noche de partido' },
  { clase: 'galeria__item--b', foto: 'fachada-de-noche', widths: [320, 640], sizes: '(min-width: 720px) 24vw, 50vw', alt: 'La entrada de BIÉRE de noche, con la pared de botellas al fondo.', pie: 'la entrada, de noche' },
  { clase: 'galeria__item--c', foto: 'dia-de-apertura', widths: [360, 720], sizes: '(min-width: 720px) 22vw, 50vw', alt: 'El local lleno el día que abrió BIÉRE.', pie: 'el día que abrimos' },
  { clase: 'galeria__item--d', foto: 'jarras-de-la-pared', widths: [400, 560, 760, 1080, 1440], sizes: '(min-width: 720px) 55vw, 100vw', alt: 'Un grupo de amigos en una mesa de BIÉRE, bajo las jarras amarillas dibujadas en la pared.', pie: 'bajo las jarras de la pared' },
];
---
<section class="section ambiente" id="ambiente" aria-labelledby="ambiente-title">
  <div class="wrap">
    <header class="ambiente__head">
      <div>
        <h2 id="ambiente-title" class="display h2" data-reveal="line">
          <span class="line"><span style="--l:0">Así se está</span></span>
          <span class="line"><span style="--l:1">en BIÉRE</span></span>
        </h2>
      </div>
      <p class="lead" data-reveal>Fotos del local tal cual, sacadas de nuestro Instagram: partidos, celebraciones y mesas llenas.</p>
    </header>

    <div class="galeria">
      {galeria.map((g) => (
        <figure class:list={['galeria__item', g.clase]}>
          <div class="frame shutter drift" data-reveal-img>
            <Picture
              src={foto(g.foto)}
              formats={['avif', 'webp']}
              widths={g.widths}
              sizes={g.sizes}
              quality={52}
              loading="lazy"
              decoding="async"
              alt={g.alt}
            />
          </div>
          <figcaption class="mano">{g.pie}</figcaption>
        </figure>
      ))}
    </div>

    <aside class="celebra" aria-labelledby="celebra-title" data-reveal>
      <div class="celebra__copy">
        <h3 id="celebra-title" class="display celebra__title">¿Celebras algo?</h3>
        <p>Cumpleaños, cenas de grupo o una reunión con amigos: escríbenos por Instagram o llámanos y preparamos los pasapalos.</p>
      </div>
      <div class="btn-row">
        <a class="btn btn--cana" href={negocio.enlaces.instagram} target="_blank" rel="noopener">
          <Icon name="instagram" class="btn__icon" /> Escribir por Instagram<span class="sr-only"> (se abre en otra pestaña)</span>
        </a>
        <a class="btn btn--ghost" href={`tel:${negocio.telefono.enlace}`}>
          <Icon name="telefono" class="btn__icon" /> {negocio.telefono.visible}
        </a>
      </div>
    </aside>
  </div>
</section>
