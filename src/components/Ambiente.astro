---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import { foto, negocio } from '../lib/site';

const galeria = [
  { clase: 'galeria__item--a', foto: 'brindis-cocteles', widths: [420, 720, 1080], sizes: '(min-width: 720px) 40vw, 100vw', alt: 'Tres amigas brindan con cócteles en la barra de BIÉRE, con la pared de botellas al fondo.', pie: 'brindis en barra' },
  { clase: 'galeria__item--b', foto: 'noche-de-futbol', widths: [360, 720], sizes: '(min-width: 720px) 24vw, 50vw', alt: 'Noche de partido en BIÉRE: el local lleno mirando el fútbol en la pantalla.', pie: 'noche de partido' },
  { clase: 'galeria__item--c', foto: 'fachada-de-noche', widths: [320, 640], sizes: '(min-width: 720px) 22vw, 50vw', alt: 'La puerta de BIÉRE de noche, con el letrero redondo iluminado.', pie: 'la puerta, de noche' },
  { clase: 'galeria__item--d', foto: 'mechada-en-mesa', widths: [420, 720, 1179], sizes: '(min-width: 720px) 55vw, 100vw', alt: 'Plato con carne mechada y queso rallado en una mesa de BIÉRE, con salsas y una malta.', pie: 'la mesa, llena' },
];
---
<section class="section ambiente" id="ambiente" aria-labelledby="ambiente-title">
  <div class="wrap">
    <header class="ambiente__head">
      <div>
        <p class="eyebrow">Ambiente</p>
        <h2 id="ambiente-title" class="display h2" data-reveal="line">
          <span class="line"><span style="--l:0">La noche</span></span>
          <span class="line"><span style="--l:1">en BIÉRE</span></span>
        </h2>
      </div>
      <p class="lead" data-reveal>Pantallas para el fútbol, mesas para compartir y la pared de botellas de fondo. Aquí se viene a cenar, a ver el partido o a celebrar.</p>
    </header>

    <div class="galeria">
      {galeria.map((g) => (
        <figure class:list={['galeria__item', g.clase]}>
          <div class="frame shutter drift" data-reveal-img>
            <Picture
              src={foto(g.foto)}
              formats={['avif', 'webp']}
              widths={g.widths}
              sizes={g.sizes}
              quality={66}
              loading="lazy"
              decoding="async"
              alt={g.alt}
            />
          </div>
          <figcaption class="mano">{g.pie}</figcaption>
        </figure>
      ))}
    </div>

    <aside class="celebra" aria-labelledby="celebra-title" data-reveal>
      <div class="celebra__copy">
        <h3 id="celebra-title" class="display celebra__title">¿Celebras algo?</h3>
        <p>Cumpleaños, cenas de grupo o una reunión con amigos. Escríbenos por Instagram o llámanos y lo preparamos: nosotros nos encargamos de los pasapalos.</p>
      </div>
      <div class="btn-row">
        <a class="btn btn--cana" href={negocio.enlaces.instagram} target="_blank" rel="noopener">
          <Icon name="instagram" class="btn__icon" /> Escribir por Instagram<span class="sr-only"> (se abre en otra pestaña)</span>
        </a>
        <a class="btn btn--ghost" href={`tel:${negocio.telefono.enlace}`}>
          <Icon name="telefono" class="btn__icon" /> {negocio.telefono.visible}
        </a>
      </div>
    </aside>
  </div>
</section>
