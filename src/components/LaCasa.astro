---
import { Picture } from 'astro:assets';
import { foto, negocio } from '../lib/site';

// Cómo es un día en BIÉRE, de mediodía a la noche.
const momentos = [
  { cuando: 'A mediodía', que: 'Menú del día casero, distinto cada día.' },
  { cuando: 'Por la noche', que: 'Arepas, tequeños y algo para picar con la cerveza.' },
  { cuando: 'Si hay partido', que: 'Se pone en las pantallas del local.' },
  { cuando: 'Si celebras algo', que: 'Escríbenos y preparamos los pasapalos.', enlace: true },
];
---
<section class="section casa" id="la-casa" aria-labelledby="casa-title">
  <div class="wrap casa__grid">
    <figure class="casa__media">
      <div class="frame shutter drift casa__frame" data-reveal-img>
        <Picture
          src={foto('puerta-de-biere')}
          formats={['avif', 'webp']}
          widths={[400, 560, 760, 960]}
          sizes="(min-width: 1024px) 38vw, 100vw"
          quality={52}
          loading="lazy"
          decoding="async"
          alt="Gente en la puerta de BIÉRE de noche, bajo el letrero redondo iluminado con el logotipo."
        />
      </div>
      <figcaption class="casa__caption mano">La puerta, en Dalmacio García Izcara.</figcaption>
    </figure>

    <div class="casa__content">
      <h2 id="casa-title" class="display h2 casa__title" data-reveal="line">
        <span class="line"><span style="--l:0">Bar de barrio,</span></span>
        <span class="line"><span style="--l:1" class="cana">cocina venezolana.</span></span>
      </h2>
      <p class="lead casa__lead" data-reveal>
        BIÉRE ocupa el local de un bar que ya conocía todo el barrio, ahora con nombre nuevo y gente nueva al frente. En la cocina, recetas venezolanas: arepas, tequeños, empanadas y cachapas. En la barra, cerveza nacional e importada (también Polar, la venezolana), cócteles de la casa y vino.
      </p>

      <dl class="casa__dia">
        {momentos.map((m, i) => (
          <div class="casa__momento" data-reveal style={`--i:${i}`}>
            <dt>{m.cuando}</dt>
            <dd>
              {m.enlace ? (
                <><a href={negocio.enlaces.instagram} target="_blank" rel="noopener">Escríbenos</a> y preparamos los pasapalos.</>
              ) : m.que}
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>
