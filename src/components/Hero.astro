---
import { getImage, Picture } from 'astro:assets';
import Icon from './Icon.astro';
import LetrasBiere from './LetrasBiere.astro';
import { foto, negocio, url } from '../lib/site';

// El nombre BIÉRE como ventana a la pared de botellas; al hacer scroll se cruza la «I» y se llega a la barra.
// Sin JavaScript o con "reducir movimiento" se muestra directamente la última escena.
const [avif, webp, fallback] = await Promise.all([
  getImage({ src: foto('interior-botellas'), format: 'avif', widths: [760, 1000, 1360], quality: 45 }),
  getImage({ src: foto('interior-botellas'), format: 'webp', widths: [760, 1000, 1360], quality: 52 }),
  getImage({ src: foto('interior-botellas'), format: 'jpg', width: 1100, quality: 60 }),
]);
const TAMANOS = '(max-aspect-ratio: 1/1) 130vw, 100vw';

// Lo que "se sirve" en la barra al entrar.
const servido = [
  { foto: 'hero-arepa-mechada', pie: 'arepa de mechada', alt: 'Arepa con carne mechada y queso rallado en una mesa de BIÉRE.' },
  { foto: 'brindis-pared-botellas', pie: 'birra bien fría', alt: 'Dos botellas de cerveza brindando en la barra de BIÉRE.' },
  { foto: 'brindis-cocteles', pie: 'los panas', alt: 'Tres amigas brindan con cócteles en la barra de BIÉRE.' },
];

const cerrados = negocio.horario.dias.filter((d) => !d.tramos.length).map((d) => d.dia);
const cuando = cerrados.length ? `todos los días menos el ${cerrados.join(' y el ')}` : 'todos los días';
---
<section class="cine" data-cine aria-labelledby="hero-title">
  <div class="cine__stage" data-cine-stage>
    <!-- Dentro del bar -->
    <div class="cine__dentro">
      <picture>
        <source type="image/avif" srcset={avif.srcSet.attribute} sizes={TAMANOS} />
        <source type="image/webp" srcset={webp.srcSet.attribute} sizes={TAMANOS} />
        <img
          src={fallback.src}
          width={fallback.attributes.width}
          height={fallback.attributes.height}
          alt="La pared de botellas de BIÉRE, iluminada, de suelo a techo."
          loading="eager"
          fetchpriority="high"
        />
      </picture>
      <div class="cine__sombra" aria-hidden="true"></div>
    </div>

    <!-- El nombre, recortado sobre el negro -->
    <div class="cine__calle">
      <LetrasBiere />
    </div>

    <div class="cine__intro" aria-hidden="true">
      <p class="cine__marca">Bar y cocina venezolana en Cuenca</p>
      <p class="cine__guia"><span class="mano">desliza</span>
        <svg viewBox="0 0 40 60" focusable="false"><path d="M20 4c-6 14 6 22 0 36M10 32l10 14 10-14" /></svg>
      </p>
    </div>

    <!-- Ya dentro -->
    <div class="cine__barra">
      <div class="wrap cine__barra-inner">
        <div class="cine__texto">
          <h1 id="hero-title" class="cine__titulo display">
            <span class="sr-only">BIÉRE, bar y cocina venezolana en Cuenca: </span>
            <span class="cine__linea"><span>Arepas,</span></span>
            <span class="cine__linea"><span>birras</span></span>
            <span class="cine__linea cana"><span>y panas.</span></span>
          </h1>
          <p class="cine__lead">Cocina venezolana y cerveza fría en C. Dalmacio García Izcara, 9. Comidas y cenas {cuando}.</p>
          <div class="btn-row">
            <a class="btn btn--cana" href={negocio.enlaces.glovo} target="_blank" rel="noopener">
              Pedir a domicilio <Icon name="flecha" class="btn__icon" /><span class="sr-only"> en Glovo (se abre en otra pestaña)</span>
            </a>
            <a class="btn btn--ghost" href={url('#carta')}>Ver la carta</a>
          </div>
          <p class="cine__nota">A domicilio con Glovo, según tu dirección y su horario. <a href={url('#visitanos')} data-estado-texto>Ver horario del local</a></p>
        </div>

        <ul class="cine__servido" role="list">
          {servido.map((s, i) => (
            <li class="cine__plato" style={`--i:${i}`}>
              <figure>
                <div class="frame">
                  <Picture src={foto(s.foto)} formats={['avif', 'webp']} widths={[280, 420, 560, 720, 820]} sizes="(min-width: 1024px) 32vw, 30vw" quality={52} loading="lazy" fetchpriority="low" decoding="async" alt={s.alt} />
                </div>
                <figcaption class="mano">{s.pie}</figcaption>
              </figure>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
